<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180" Height="1080" MinWidth="820" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI Variable Text" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" AllowDrop="True">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#111315"/><SolidColorBrush x:Key="WindowOverlayBrush" Color="#80111315"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#E6202326"/><SolidColorBrush x:Key="SurfaceBrush" Color="#E6191C1F"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E624282C"/><SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F02A3035"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F6F8"/><SolidColorBrush x:Key="MutedBrush" Color="#A4ACB5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#803D444B"/><SolidColorBrush x:Key="AccentBrush" Color="#E53935"/><SolidColorBrush x:Key="AccentSoftBrush" Color="#664A2426"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/>
      <Setter Property="MinHeight" Value="42"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.76"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.40"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger></Style.Triggers></Style>
    <Style x:Key="AccentCircleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Width="48" Height="48"><Ellipse x:Name="Glow" Fill="Transparent" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/><Ellipse x:Name="Swatch" Fill="{TemplateBinding Background}" Margin="6"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.58"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SwitchToggle" TargetType="ToggleButton"><Setter Property="Width" Value="56"/><Setter Property="Height" Value="32"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Track" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid Margin="4"><Ellipse x:Name="Knob" Width="22" Height="22" Fill="{DynamicResource MutedBrush}" HorizontalAlignment="Left"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Knob" Property="Fill" Value="White"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.84"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ModernSlider" TargetType="Slider"><Setter Property="Height" Value="32"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="1,0"><Track x:Name="PART_Track" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" CornerRadius="3" Background="{DynamicResource AccentBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="20" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource TextBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" CornerRadius="3" Background="{DynamicResource SurfaceAltBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="LogScrollThumb" TargetType="Thumb"><Setter Property="Width" Value="6"/><Setter Property="MinHeight" Value="32"/><Setter Property="Opacity" Value="0.48"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="{DynamicResource MutedBrush}" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter Property="Opacity" Value="0.92"/><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="LogScrollBar" TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Margin" Value="1,4,1,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" IsTabStop="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource LogScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" IsTabStop="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="56"/><Setter Property="ColumnHeaderHeight" Value="46"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="True"/><Setter Property="CanUserResizeColumns" Value="True"/><Setter Property="CanUserSortColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="8,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Border x:Name="RowCard" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><DataGridCellsPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowCard" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowCard" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="RowCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="14,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="FolderChip" TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chip" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid x:Name="BackgroundFrame" ClipToBounds="True">
    <Canvas ClipToBounds="True"><Image x:Name="BackgroundImage" Stretch="Fill"/></Canvas><Border x:Name="BackgroundOverlay" Background="{DynamicResource WindowOverlayBrush}"/>
    <Grid><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="LogButton" Margin="0,0,10,0"/><Button x:Name="SettingsButton" MinWidth="110"/></StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="ContentHost" Grid.Row="1">
        <Grid x:Name="HomePage" Margin="28,20,28,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,16"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="AddFolderButton" Grid.Column="0" Style="{StaticResource AccentButton}" Height="44"/><Button x:Name="ManageFoldersButton" Grid.Column="1" Height="44" Margin="10,0,0,0" Visibility="Collapsed"/><Button x:Name="ScanButton" Grid.Column="2" Height="44" Margin="10,0,14,0"/><TextBlock x:Name="FolderSummary" Grid.Column="3" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/></Grid>
            <Border x:Name="FolderRemovalPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="FolderRemovalHint" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/><ListBox x:Name="FolderList" Background="Transparent" BorderThickness="0" SelectionMode="Single" ItemContainerStyle="{StaticResource FolderChip}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></StackPanel></Border>
          </StackPanel></Border>
          <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" ClipToBounds="True" Padding="4"><DataGrid x:Name="ProjectGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn SortMemberPath="Name" Binding="{Binding Name}" Width="160" MinWidth="120"/><DataGridTextColumn SortMemberPath="MinecraftDisplay" Binding="{Binding MinecraftDisplay}" Width="100" MinWidth="90"/><DataGridTextColumn SortMemberPath="EnvironmentDisplay" Binding="{Binding EnvironmentDisplay}" Width="110" MinWidth="100"/><DataGridTextColumn SortMemberPath="LoaderDisplay" Binding="{Binding LoaderDisplay}" Width="190" MinWidth="130"/><DataGridTextColumn SortMemberPath="JavaDisplay" Binding="{Binding JavaDisplay}" Width="150" MinWidth="120"/><DataGridTextColumn SortMemberPath="StatusDisplay" Binding="{Binding StatusDisplay}" Width="190" MinWidth="150"/></DataGrid.Columns></DataGrid></Border>
          <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18,15" Margin="0,16,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="2.2*"/></Grid.ColumnDefinitions><TextBlock x:Name="DetailsTitle" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/><TextBlock x:Name="DetailMinecraft" Grid.Row="1" Grid.Column="0"/><TextBlock x:Name="DetailEnvironment" Grid.Row="1" Grid.Column="1"/><StackPanel Grid.Row="1" Grid.Column="2"><TextBlock x:Name="DetailLoader" TextWrapping="Wrap"/><TextBlock x:Name="DetailJava" Margin="0,7,0,0"/><TextBlock x:Name="DetailStatus" Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
          <StackPanel Grid.Row="3" Orientation="Horizontal"><Button x:Name="LaunchButton" Style="{StaticResource AccentButton}" MinWidth="160" Height="44"/><Button x:Name="TasksButton" MinWidth="160" Height="44" Margin="10,0,0,0"/><Button x:Name="CleanBuildButton" MinWidth="180" Height="44" Margin="10,0,0,0"/><Button x:Name="BuildButton" MinWidth="130" Height="44" Margin="10,0,0,0"/></StackPanel><TextBlock x:Name="StatusText" Grid.Row="4" Foreground="{DynamicResource MutedBrush}" Margin="2,14,0,0" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="28,16,28,16">
          <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18,3" Margin="0,0,0,12"><StackPanel>
              <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="AutoCloseLabel" FontSize="14"/><TextBlock x:Name="AutoCloseHint" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,14,0" TextWrapping="Wrap"/></StackPanel><ToggleButton x:Name="AutoCloseToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/></Grid><Border Height="1" Background="{DynamicResource BorderBrush}"/>
              <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="RememberLabel" FontSize="14"/><TextBlock x:Name="RememberHint" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,14,0" TextWrapping="Wrap"/></StackPanel><ToggleButton x:Name="RememberToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/></Grid><Border Height="1" Background="{DynamicResource BorderBrush}"/>
              <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="AutoCheckLabel" FontSize="14"/><TextBlock x:Name="AutoCheckHint" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,14,0" TextWrapping="Wrap"/></StackPanel><ToggleButton x:Name="AutoCheckToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/></Grid><Border Height="1" Background="{DynamicResource BorderBrush}"/>
              <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="AutoScanNewLabel" FontSize="14"/><TextBlock x:Name="AutoScanNewHint" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,14,0" TextWrapping="Wrap"/></StackPanel><ToggleButton x:Name="AutoScanNewToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/></Grid>
            </StackPanel></Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18,3"><StackPanel>
              <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="ThemeTitle" FontSize="17" FontWeight="SemiBold"/><UniformGrid Grid.Column="1" Columns="2"><Button x:Name="DarkThemeButton" Height="46" Margin="0,0,5,0"/><Button x:Name="LightThemeButton" Height="46" Margin="5,0,0,0"/></UniformGrid></Grid><Border Height="1" Background="{DynamicResource BorderBrush}"/>
              <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="AccentTitle" FontSize="17" FontWeight="SemiBold"/><StackPanel x:Name="AccentPanel" Grid.Column="1" Orientation="Horizontal"/></Grid><Border Height="1" Background="{DynamicResource BorderBrush}"/>
              <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="LanguageTitle" FontSize="17" FontWeight="SemiBold"/><UniformGrid x:Name="LanguagePanel" Grid.Column="1" Columns="3" Rows="2" Margin="-4"/></Grid><Border Height="1" Background="{DynamicResource BorderBrush}"/>
              <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="BackgroundTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,12,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="BackgroundHint" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><Button x:Name="ChooseBackgroundButton" Height="42"/><Button x:Name="ClearBackgroundButton" Height="42" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="BackgroundPathText" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="1,7,0,0"/></StackPanel></Grid><Border Height="1" Background="{DynamicResource BorderBrush}"/>
              <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="VisualDebugTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,12,0"/><StackPanel Grid.Column="1"><Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="BlurLabel" FontSize="14"/><TextBlock x:Name="BlurValueText" Grid.Column="1" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="BlurSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8"/><Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="UiOpacityLabel" FontSize="14"/><TextBlock x:Name="UiOpacityValueText" Grid.Column="1" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="UiOpacitySlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/></StackPanel></Grid>
            </StackPanel></Border>
            <TextBlock x:Name="ContactText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="2,4,0,4"/>
          </StackPanel></ScrollViewer>
        </Grid>

        <Grid x:Name="LogPage" Visibility="Collapsed" Margin="28,18,28,22">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock x:Name="LogPageTitle" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="LogPageSubtitle" Foreground="{DynamicResource MutedBrush}" Margin="1,4,0,14"/></StackPanel>
          <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="LogHeader" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="LogStatus" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/><TextBlock x:Name="LogExplanation" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,18,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="ClearLogButton" Height="42"/><Button x:Name="CopyLogButton" Height="42" Margin="8,0,0,0"/><Button x:Name="StopTaskButton" Height="42" Margin="8,0,0,0"/></StackPanel>
          </Grid></Border>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="LogStdoutLabel" FontWeight="SemiBold" Margin="1,0,0,10"/><TextBox x:Name="LogStdout" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource LogScrollBar}"/></TextBox.Resources></TextBox></Grid></Border>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="LogStderrLabel" FontWeight="SemiBold" Margin="1,0,0,10"/><TextBox x:Name="LogStderr" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource LogScrollBar}"/></TextBox.Resources></TextBox></Grid></Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
